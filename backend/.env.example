# ---------------------------------------------------------
# Firebase Admin SDK (backend)
# ---------------------------------------------------------
# Preferred: place your downloaded service account JSON at
#   backend/serviceAccountKey.json
# (Firebase Console -> Project Settings -> Service Accounts -> Generate new private key)
# It will be auto-loaded; you do NOT need to set anything below for it.
#
# Alternative for hosting platforms that can't store a file:
# paste the whole JSON as a single-line string here:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional: only needed if you use Firebase Storage for attachments
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# Demo account passwords (used only by scripts/seed.js). Change before deploying.
DEMO_STUDENT_PASSWORD=Student@123
DEMO_STAFF_PASSWORD=Staff@123
DEMO_COORDINATOR_PASSWORD=Coordinator@123
DEMO_HOD_PASSWORD=Hod@123
DEMO_PRINCIPAL_PASSWORD=Principal@123
DEMO_ADMIN_PASSWORD=Admin@123
